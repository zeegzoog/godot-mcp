# Environment & secrets
.env*
!.env.example

# Local MCP client config with machine-specific paths
.mcp.json

# Internal references & scratchpad
.references/
scratch/

# Rust build output
target/
**/*.rs.bk

# Local binaries & release archives
bin/
dist/
*.exe
*.pdb
*.dll
*.so
*.dylib

# Godot editor cache & local export settings
.godot/
export_presets.cfg

# IDE & editor files
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Skills (each skill directory is ignored unless listed below)
/.*/skills/*
!/.*/skills/release
!/.*/skills/repo-steward
!/.*/skills/agents-init

# SDD engine
/.magic/
/.*/skills/magic-*/
/.*/*/magic*.md

# SDD generated artifacts, rebuilt on demand by the engine (the rest of .design/ is shared)
/.design/*graph*.*
/.design/*cache*/
/.design/wiki/
